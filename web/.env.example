# Postgres connection string (Vercel Postgres / Neon / Supabase).
# For Supabase use the "Transaction" pooler URL (port 6543).
POSTGRES_URL=postgres://user:password@host:5432/miles

# Secret used to sign auth tokens. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Your login. Generate the hash with: npm run hash-password -- 'your-password'
MILES_EMAIL=you@example.com
MILES_PASSWORD_HASH=

# Optional: set to render Google Maps instead of Leaflet/OpenStreetMap.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
